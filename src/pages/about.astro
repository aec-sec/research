---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="About | AEC Security"
	description="About AEC Security — offensive security, penetration testing, red team operations and independent security research."
>
	<main>
		<!-- HERO -->
		<section class="hero">
			<div class="breadcrumb">
				<a href="/">AECSEC</a>
				<span>/</span>
				<span>ABOUT</span>
			</div>

			<div class="hero-grid">
				<div>
					<span class="eyebrow">ABOUT AECSEC</span>

					<h1>
						Offensive security.<br />
						<span>Built on practice.</span>
					</h1>
				</div>

				<div class="hero-copy">
					<p>
						AECSEC is my independent security research and technical
						portfolio, documenting practical work across penetration
						testing, red team operations and vulnerability research.
					</p>

					<p>
						The aim is simple: understand how systems fail, reproduce
						security weaknesses in controlled environments, and document
						the technical details clearly enough to be useful.
					</p>
				</div>
			</div>
		</section>

		<!-- PROFILE -->
		<section class="profile">
			<div class="section-label">
				<span>01</span>
				<span>PROFILE</span>
			</div>

			<div class="profile-grid">
				<div>
					<h2>Security from an adversarial perspective.</h2>
				</div>

				<div class="profile-copy">
					<p>
						My work focuses on offensive security: approaching applications,
						infrastructure and identity systems from the perspective of an
						attacker and identifying where security boundaries can fail.
					</p>

					<p>
						I work across web application security, infrastructure testing,
						Active Directory and assumed-breach scenarios, with an emphasis
						on manual testing and understanding the underlying behaviour
						rather than relying solely on automated tooling.
					</p>

					<p>
						AECSEC provides a place to develop that work further through
						independent research, lab environments, vulnerability analysis
						and security tooling.
					</p>
				</div>
			</div>
		</section>

		<!-- FOCUS -->
		<section class="focus">
			<div class="section-label">
				<span>02</span>
				<span>FOCUS</span>
			</div>

			<div class="focus-grid">
				<div class="focus-item">
					<span class="focus-number">01</span>

					<div>
						<h3>Web Application Security</h3>
						<p>
							Authentication, authorisation, session management, injection,
							business logic, API security and application attack surface.
						</p>
					</div>
				</div>

				<div class="focus-item">
					<span class="focus-number">02</span>

					<div>
						<h3>Infrastructure</h3>
						<p>
							Network services, exposed infrastructure, authentication
							paths, configuration weaknesses and internal attack surface.
						</p>
					</div>
				</div>

				<div class="focus-item">
					<span class="focus-number">03</span>

					<div>
						<h3>Red Team Operations</h3>
						<p>
							Assumed-breach testing, Active Directory, attack-path
							discovery, lateral movement and adversary-oriented testing.
						</p>
					</div>
				</div>

				<div class="focus-item">
					<span class="focus-number">04</span>

					<div>
						<h3>Vulnerability Research</h3>
						<p>
							Reproduction, root-cause analysis, exploitation,
							patch analysis and technical documentation of vulnerabilities.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- APPROACH -->
		<section class="approach">
			<div class="section-label">
				<span>03</span>
				<span>APPROACH</span>
			</div>

			<div class="approach-grid">
				<div class="approach-intro">
					<h2>Understand the system, not just the finding.</h2>

					<p>
						A vulnerability is more useful when its underlying cause,
						security boundary and realistic impact are understood.
					</p>
				</div>

				<div class="principles">
					<div class="principle">
						<span>01</span>
						<div>
							<h3>Enumerate</h3>
							<p>
								Build an accurate understanding of the application,
								infrastructure and available attack surface.
							</p>
						</div>
					</div>

					<div class="principle">
						<span>02</span>
						<div>
							<h3>Validate</h3>
							<p>
								Verify behaviour manually and distinguish exploitable
								weaknesses from scanner output and theoretical issues.
							</p>
						</div>
					</div>

					<div class="principle">
						<span>03</span>
						<div>
							<h3>Understand</h3>
							<p>
								Determine why the weakness exists and which security
								control or trust boundary has failed.
							</p>
						</div>
					</div>

					<div class="principle">
						<span>04</span>
						<div>
							<h3>Document</h3>
							<p>
								Produce clear technical material that makes the research
								reproducible and useful to others.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- SITE -->
		<section class="site">
			<div class="section-label">
				<span>04</span>
				<span>AECSEC</span>
			</div>

			<div class="site-grid">
				<div>
					<h2>What you'll find here.</h2>
				</div>

				<div class="site-links">
					<a href="/research">
						<div>
							<span>RESEARCH</span>
							<h3>Security Research</h3>
							<p>
								Vulnerability analysis, technical deep dives and
								independent security research.
							</p>
						</div>

						<span class="arrow">→</span>
					</a>

					<a href="/labs">
						<div>
							<span>LABS</span>
							<h3>Labs & Machines</h3>
							<p>
								Hands-on offensive security exercises and practical
								lab write-ups.
							</p>
						</div>

						<span class="arrow">→</span>
					</a>

					<a href="/findings">
						<div>
							<span>FINDINGS</span>
							<h3>Vulnerability Reference</h3>
							<p>
								Curated references covering common security weaknesses
								and remediation.
							</p>
						</div>

						<span class="arrow">→</span>
					</a>

					<a href="/projects">
						<div>
							<span>PROJECTS</span>
							<h3>Projects & Tooling</h3>
							<p>
								Security tooling, scripts and experiments developed
								alongside research.
							</p>
						</div>

						<span class="arrow">→</span>
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	main {
		max-width: 1320px;
		margin: 0 auto;
		padding: 0 32px;
	}

	.hero {
		padding: 75px 0 90px;
		border-bottom: 1px solid var(--border);
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 70px;

		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 11px;
		letter-spacing: 0.08em;
		color: var(--text-muted);
	}

	.breadcrumb a {
		color: var(--accent);
		text-decoration: none;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		align-items: end;
		gap: 100px;
	}

	.eyebrow {
		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 11px;
		letter-spacing: 0.14em;
		color: var(--accent);
	}

	h1 {
		margin: 15px 0 0;
		font-size: clamp(46px, 5.5vw, 68px);
		line-height: 1.04;
		letter-spacing: -0.05em;
	}

	h1 span {
		color: var(--text-muted);
	}

	.hero-copy {
		max-width: 590px;
	}

	.hero-copy p {
		margin: 0;
		color: var(--text-muted);
		font-size: 15px;
		line-height: 1.85;
	}

	.hero-copy p + p {
		margin-top: 20px;
	}

	.profile,
	.focus,
	.approach,
	.site {
		padding: 85px 0;
		border-bottom: 1px solid var(--border);
	}

	.section-label {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 45px;

		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 10px;
		letter-spacing: 0.13em;
		color: var(--text-muted);
	}

	.section-label span:first-child {
		color: var(--accent);
	}

	.profile-grid {
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		gap: 100px;
	}

	.profile h2,
	.approach h2,
	.site h2 {
		margin: 0;
		max-width: 500px;
		font-size: 34px;
		line-height: 1.2;
		letter-spacing: -0.035em;
	}

	.profile-copy {
		max-width: 700px;
	}

	.profile-copy p {
		margin: 0;
		color: var(--text-muted);
		font-size: 15px;
		line-height: 1.85;
	}

	.profile-copy p + p {
		margin-top: 20px;
	}

	.focus-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		border-top: 1px solid var(--border);
		border-left: 1px solid var(--border);
	}

	.focus-item {
		display: flex;
		gap: 25px;
		padding: 32px;

		border-right: 1px solid var(--border);
		border-bottom: 1px solid var(--border);

		background: var(--surface);
	}

	.focus-number {
		flex-shrink: 0;

		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 10px;
		color: var(--accent);
	}

	.focus-item h3 {
		margin: 0 0 10px;
		font-size: 18px;
	}

	.focus-item p {
		margin: 0;
		color: var(--text-muted);
		font-size: 13px;
		line-height: 1.7;
	}

	.approach-grid {
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		gap: 100px;
	}

	.approach-intro > p {
		max-width: 500px;
		margin: 20px 0 0;
		color: var(--text-muted);
		font-size: 14px;
		line-height: 1.75;
	}

	.principles {
		border-top: 1px solid var(--border);
	}

	.principle {
		display: grid;
		grid-template-columns: 45px 1fr;
		gap: 20px;
		padding: 25px 0;
		border-bottom: 1px solid var(--border);
	}

	.principle > span {
		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 10px;
		color: var(--accent);
		padding-top: 4px;
	}

	.principle h3 {
		margin: 0 0 7px;
		font-size: 16px;
	}

	.principle p {
		max-width: 600px;
		margin: 0;
		color: var(--text-muted);
		font-size: 13px;
		line-height: 1.65;
	}

	.site {
		border-bottom: 0;
		padding-bottom: 110px;
	}

	.site-grid {
		display: grid;
		grid-template-columns: 0.65fr 1.35fr;
		gap: 100px;
	}

	.site-links {
		border-top: 1px solid var(--border);
	}

	.site-links a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 35px;

		padding: 25px 8px;
		border-bottom: 1px solid var(--border);

		color: inherit;
		text-decoration: none;

		transition:
			padding 150ms ease,
			background 150ms ease;
	}

	.site-links a:hover {
		padding-left: 16px;
		padding-right: 16px;
		background: var(--surface);
	}

	.site-links a > div > span {
		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 9px;
		letter-spacing: 0.12em;
		color: var(--accent);
	}

	.site-links h3 {
		margin: 6px 0 6px;
		font-size: 17px;
	}

	.site-links p {
		max-width: 600px;
		margin: 0;
		color: var(--text-muted);
		font-size: 12px;
		line-height: 1.6;
	}

	.arrow {
		flex-shrink: 0;
		color: var(--text-muted);
		font-size: 20px;
		transition: 150ms ease;
	}

	.site-links a:hover .arrow {
		color: var(--accent);
		transform: translateX(3px);
	}

	@media (max-width: 850px) {
		.hero-grid,
		.profile-grid,
		.approach-grid,
		.site-grid {
			grid-template-columns: 1fr;
			gap: 45px;
		}

		.focus-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 650px) {
		main {
			padding: 0 18px;
		}

		.hero {
			padding: 55px 0 70px;
		}

		.breadcrumb {
			margin-bottom: 50px;
		}

		h1 {
			font-size: 44px;
		}

		.profile,
		.focus,
		.approach,
		.site {
			padding: 65px 0;
		}

		.profile h2,
		.approach h2,
		.site h2 {
			font-size: 28px;
		}
	}
</style>