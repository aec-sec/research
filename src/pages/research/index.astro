---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const research = (await getCollection('research'))
	.filter((entry) => !entry.data.draft)
	.sort(
		(a, b) =>
			b.data.published.valueOf() - a.data.published.valueOf()
	);

// Research is sorted newest-first, so the newest article
// marked as featured is selected for the featured position.
const featuredArticle = research.find(
	(article) => article.data.featured
);

const archiveArticles = research.filter(
	(article) => article.id !== featuredArticle?.id
);
---

<Layout
	title="Research | AEC Security"
	description="Vulnerability research, CVE analysis and offensive security research."
>
	<main>
		<section class="research-hero">
			<div class="breadcrumb">
				<span>~/</span>research
			</div>

			<h1>Security Research</h1>

			<p>
				Technical analysis of vulnerabilities, exploitation techniques,
				security controls and offensive security concepts.
			</p>
		</section>

		<section class="research-content">
			<div class="research-header">
				<div>
					<span class="eyebrow">RESEARCH ARCHIVE</span>
					<h2>Published Research</h2>
				</div>

				<div class="filters">
					<button class="active">All</button>
					<button>CVEs</button>
					<button>Web</button>
					<button>Infrastructure</button>
					<button>Red Team</button>
				</div>
			</div>

			{featuredArticle && (
	<a
		class="featured"
		href={`/research/${featuredArticle.id}`}
	>
		<div class="featured-label">FEATURED RESEARCH</div>

		<div class="featured-content">
			<div>
				<div class="meta">
					<span>{featuredArticle.data.category.toUpperCase()}</span>
					<span>•</span>
					<span>
						{featuredArticle.data.published.toLocaleDateString('en-GB')}
					</span>
				</div>

				<h3>{featuredArticle.data.title}</h3>

				<p>{featuredArticle.data.description}</p>

				<div class="tags">
					{featuredArticle.data.tags.map((tag) => (
						<span>{tag}</span>
					))}
				</div>
			</div>

			<div class="featured-icon">
				<span>0x01</span>
			</div>
		</div>
	</a>
)}

{archiveArticles.length > 0 ? (
	<div class="research-list">
		{archiveArticles.map((article) => (
			<a
				class="research-item"
				href={`/research/${article.id}`}
			>
				<div class="research-meta">
					<span>{article.data.category}</span>
					<span>
						{article.data.published.toLocaleDateString('en-GB')}
					</span>
				</div>

				<h3>{article.data.title}</h3>

				<p>{article.data.description}</p>

				<div class="tags">
					{article.data.tags.map((tag) => (
						<span>{tag}</span>
					))}
				</div>

				<div class="read-more">
					Read analysis <span>→</span>
				</div>
			</a>
		))}
	</div>
) : (
	<div class="empty-state">
		<div class="empty-code">[ ]</div>

		<div>
			<h3>No additional research published yet.</h3>
			<p>
				New vulnerability research and technical analysis will appear here.
			</p>
		</div>
	</div>
)}
		</section>

		<section class="methodology">
			<div class="methodology-heading">
				<span class="eyebrow">APPROACH</span>
				<h2>Research methodology</h2>
			</div>

			<div class="methodology-grid">
				<div class="method">
					<span>01</span>
					<h3>Identify</h3>
					<p>
						Understand the affected technology, attack surface,
						preconditions and vulnerability class.
					</p>
				</div>

				<div class="method">
					<span>02</span>
					<h3>Reproduce</h3>
					<p>
						Construct an isolated lab and reproduce the vulnerable
						behaviour under controlled conditions.
					</p>
				</div>

				<div class="method">
					<span>03</span>
					<h3>Analyse</h3>
					<p>
						Investigate the root cause, exploitation primitive and
						security boundary being violated.
					</p>
				</div>

				<div class="method">
					<span>04</span>
					<h3>Defend</h3>
					<p>
						Review patches, detection opportunities, mitigations and
						the wider defensive lessons.
					</p>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	main {
		max-width: 1180px;
		margin: 0 auto;
		padding: 0 24px;
	}

	.research-hero {
		padding: 100px 0 85px;
		max-width: 800px;
	}

	.breadcrumb {
		font-family: "SFMono-Regular", Consolas, monospace;
		color: var(--text-muted);
		font-size: 12px;
		margin-bottom: 25px;
	}

	.breadcrumb span {
		color: var(--accent);
	}

	h1 {
		font-size: clamp(48px, 6vw, 72px);
		letter-spacing: -0.05em;
		line-height: 1;
		margin: 0;
	}

	.research-hero > p {
		max-width: 680px;
		color: var(--text-muted);
		font-size: 17px;
		line-height: 1.8;
		margin: 28px 0 0;
	}

	.research-content {
		border-top: 1px solid var(--border);
		padding: 70px 0 100px;
	}

	.research-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 30px;
		margin-bottom: 38px;
	}

	.eyebrow {
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 11px;
		letter-spacing: 0.14em;
		color: var(--accent);
	}

	h2 {
		font-size: 30px;
		letter-spacing: -0.03em;
		margin: 8px 0 0;
	}

	.filters {
		display: flex;
		gap: 7px;
		flex-wrap: wrap;
	}

	.filters button {
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text-muted);
		border-radius: 5px;
		padding: 7px 11px;
		font-size: 11px;
		cursor: pointer;
	}

	.filters button:hover,
	.filters button.active {
		color: var(--accent);
		border-color: rgba(85, 214, 190, 0.35);
	}

	.featured {
		border: 1px solid var(--border);
		border-radius: 9px;
		background:
			linear-gradient(
				120deg,
				rgba(85, 214, 190, 0.04),
				transparent 45%
			),
			var(--surface);
		overflow: hidden;
        display: block;
	    color: inherit;
	    text-decoration: none;
	}

    .featured:hover {
	border-color: rgba(85, 214, 190, 0.4);
    }

	.featured-label {
		padding: 11px 20px;
		border-bottom: 1px solid var(--border);
		color: var(--accent);
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 10px;
		letter-spacing: 0.12em;
	}

	.featured-content {
		min-height: 270px;
		padding: 35px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 50px;
	}

	.meta {
		display: flex;
		gap: 10px;
		color: var(--text-muted);
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 10px;
		letter-spacing: 0.08em;
	}

	.featured h3 {
		font-size: 28px;
		letter-spacing: -0.025em;
		margin: 16px 0 13px;
	}

	.featured p {
		color: var(--text-muted);
		line-height: 1.7;
		font-size: 14px;
		max-width: 650px;
		margin: 0;
	}

	.featured-icon {
		width: 130px;
		height: 130px;
		flex-shrink: 0;
		display: grid;
		place-items: center;

		border: 1px solid var(--border);
		border-radius: 50%;

		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 20px;
		color: var(--accent);

		background:
			radial-gradient(
				circle,
				rgba(85, 214, 190, 0.09),
				transparent 65%
			);
	}

	.tags {
		display: flex;
		gap: 7px;
		flex-wrap: wrap;
		margin-top: 25px;
	}

	.tags span {
		padding: 5px 8px;
		border: 1px solid var(--border);
		border-radius: 4px;
		background: var(--tag-background);
        color: var(--text-muted);
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 10px;
	}

	.empty-state {
		display: flex;
		align-items: center;
		gap: 20px;
		margin-top: 16px;
		padding: 25px 28px;
		border: 1px dashed var(--border);
		border-radius: 8px;
	}

	.empty-code {
		color: var(--accent);
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 17px;
	}

	.empty-state h3 {
		margin: 0 0 6px;
		font-size: 15px;
	}

	.empty-state p {
		color: var(--text-muted);
		margin: 0;
		font-size: 13px;
		line-height: 1.6;
	}

	.methodology {
		border-top: 1px solid var(--border);
		padding: 80px 0 30px;
	}

	.methodology-heading {
		margin-bottom: 35px;
	}

	.methodology-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		border: 1px solid var(--border);
		border-radius: 9px;
		overflow: hidden;
	}

	.method {
		padding: 27px;
		background: var(--surface);
	}

	.method + .method {
		border-left: 1px solid var(--border);
	}

	.method > span {
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 10px;
		color: var(--accent);
	}

	.method h3 {
		margin: 28px 0 9px;
		font-size: 16px;
	}

	.method p {
		color: var(--text-muted);
		font-size: 12px;
		line-height: 1.7;
		margin: 0;
	}

	@media (max-width: 850px) {
		.research-header {
			align-items: flex-start;
			flex-direction: column;
		}

		.methodology-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.method:nth-child(3) {
			border-left: 0;
			border-top: 1px solid var(--border);
		}

		.method:nth-child(4) {
			border-top: 1px solid var(--border);
		}
	}

	@media (max-width: 600px) {
		main {
			padding: 0 18px;
		}

		.research-hero {
			padding: 65px 0;
		}

		.featured-content {
			padding: 26px;
		}

		.featured-icon {
			display: none;
		}

		.methodology-grid {
			grid-template-columns: 1fr;
		}

		.method + .method {
			border-left: 0;
			border-top: 1px solid var(--border);
		}
	}

.research-list {
	display: grid;
	gap: 12px;
	margin-top: 16px;
}

.research-item {
	display: block;
	padding: 26px 28px;
	border: 1px solid var(--border);
	border-radius: 8px;
	background: var(--surface);
	color: inherit;
	text-decoration: none;
	transition:
		border-color 0.2s ease,
		transform 0.2s ease,
		background 0.2s ease;
}

.research-item:hover {
	border-color: rgba(85, 214, 190, 0.4);
	background: var(--surface-light);
	transform: translateY(-2px);
}

.research-meta {
	display: flex;
	gap: 12px;
	margin-bottom: 12px;

	font-family: "SFMono-Regular", Consolas, monospace;
	font-size: 10px;
	letter-spacing: 0.08em;
	color: var(--accent);
}

.research-item h3 {
	margin: 0 0 9px;
	font-size: 18px;
}

.research-item p {
	margin: 0;
	max-width: 750px;
	color: var(--text-muted);
	font-size: 13px;
	line-height: 1.7;
}

.read-more {
	margin-top: 22px;
	font-family: "SFMono-Regular", Consolas, monospace;
	font-size: 11px;
	color: var(--accent);
}

.read-more span {
	display: inline-block;
	margin-left: 5px;
	transition: transform 0.2s ease;
}

.research-item:hover .read-more span {
	transform: translateX(4px);
}

</style>