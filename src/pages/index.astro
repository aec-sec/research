---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="AEC Security | Security Research"
	description="Independent cybersecurity research, penetration testing notes, vulnerability analysis and technical write-ups."
>
	<main>
		<!-- HERO -->
		<section class="hero">
			<div class="hero-content">
				<div class="status">
					<span class="status-dot"></span>
					SECURITY RESEARCH / OFFENSIVE SECURITY
				</div>

				<h1>
					Offensive Security.<br />
					<span>Technical Research.</span>
				</h1>

				<p class="hero-description">
					A collection of security research, vulnerability analysis,
					lab write-ups and technical notes covering offensive security,
					penetration testing and red team tradecraft.
				</p>

				<div class="hero-actions">
					<a class="primary-button" href="/research">
						Explore Research
						<span>→</span>
					</a>

					<a class="secondary-button" href="/about">
						About AEC
					</a>
				</div>
			</div>

			<div class="terminal">
				<div class="terminal-header">
					<div class="terminal-dots">
						<span></span>
						<span></span>
						<span></span>
					</div>

					<span>research@aec-sec</span>
				</div>

				<div class="terminal-body">
					<p>
						<span class="terminal-green">research@aec-sec</span>:<span class="terminal-blue">~</span>$
						whoami
					</p>

					<p class="terminal-output">
						security researcher
					</p>

					<p>
						<span class="terminal-green">research@aec-sec</span>:<span class="terminal-blue">~</span>$
						cat focus.txt
					</p>

					<div class="terminal-output terminal-list">
						<span>→ vulnerability research</span>
						<span>→ web application security</span>
						<span>→ red team operations</span>
						<span>→ exploit analysis</span>
						<span>→ security tooling</span>
					</div>

					<p class="terminal-line">
						<span class="terminal-green">research@aec-sec</span>:<span class="terminal-blue">~</span>$
						<span class="cursor"></span>
					</p>
				</div>
			</div>
		</section>

		<!-- AREAS -->
		<section class="section">
			<div class="section-heading">
				<div>
					<span class="eyebrow">KNOWLEDGE BASE</span>
					<h2>Research & Technical Work</h2>
				</div>

				<p>
					Technical documentation built from practical security research,
					labs and experimentation.
				</p>
			</div>

			<div class="cards">
				<a href="/research" class="card">
					<div class="card-top">
						<span class="card-number">01</span>
						<span class="card-arrow">↗</span>
					</div>

					<h3>CVE Research</h3>

					<p>
						Deep dives into vulnerabilities covering root cause,
						reproduction, exploitation, patch analysis and detection.
					</p>

					<div class="tags">
						<span>CVEs</span>
						<span>Exploitation</span>
						<span>Analysis</span>
					</div>
				</a>

				<a href="/labs" class="card">
					<div class="card-top">
						<span class="card-number">02</span>
						<span class="card-arrow">↗</span>
					</div>

					<h3>Labs & Machines</h3>

					<p>
						Structured write-ups from security labs, vulnerable machines
						and offensive security exercises.
					</p>

					<div class="tags">
						<span>AD</span>
						<span>Web</span>
						<span>Linux</span>
					</div>
				</a>

				<a href="/notes" class="card">
					<div class="card-top">
						<span class="card-number">03</span>
						<span class="card-arrow">↗</span>
					</div>

					<h3>Technical Notes</h3>

					<p>
						Concise reference material covering protocols, techniques,
						commands and security concepts.
					</p>

					<div class="tags">
						<span>Reference</span>
						<span>Methodology</span>
						<span>Notes</span>
					</div>
				</a>

				<a href="/projects" class="card">
					<div class="card-top">
						<span class="card-number">04</span>
						<span class="card-arrow">↗</span>
					</div>

					<h3>Projects & Tooling</h3>

					<p>
						Security tooling, scripts, experiments and projects developed
						alongside offensive security research.
					</p>

					<div class="tags">
						<span>Python</span>
						<span>Tools</span>
						<span>GitHub</span>
					</div>
				</a>
			</div>
		</section>

		<!-- LATEST -->
		<section class="section latest-section">
			<div class="section-heading">
				<div>
					<span class="eyebrow">LATEST</span>
					<h2>Recent Research</h2>
				</div>

				<a class="view-all" href="/research">
					View all research →
				</a>
			</div>

			<div class="research-list">
				<div class="research-placeholder">
					<div>
						<span class="placeholder-type">RESEARCH</span>
						<h3>Research archive initialising.</h3>
						<p>
							CVE analysis, vulnerability research and technical write-ups
							will appear here as they are published.
						</p>
					</div>

					<span class="placeholder-status">COMING SOON</span>
				</div>
			</div>
		</section>

		<!-- PRINCIPLES -->
		<section class="principles">
			<div class="principle">
				<span class="principle-value">01</span>
				<div>
					<h3>Understand</h3>
					<p>
						Go beyond the payload and understand the underlying weakness.
					</p>
				</div>
			</div>

			<div class="principle">
				<span class="principle-value">02</span>
				<div>
					<h3>Reproduce</h3>
					<p>
						Build repeatable labs and validate behaviour through practical testing.
					</p>
				</div>
			</div>

			<div class="principle">
				<span class="principle-value">03</span>
				<div>
					<h3>Document</h3>
					<p>
						Turn research into clear technical material that can be revisited and shared.
					</p>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	main {
		max-width: 1180px;
		margin: 0 auto;
		padding: 0 24px;
	}

	.hero {
		min-height: 650px;
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		align-items: center;
		gap: 70px;
		padding: 80px 0;
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: 10px;

		font-family:
			"SFMono-Regular",
			Consolas,
			"Liberation Mono",
			monospace;

		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.12em;
		color: var(--accent);
		margin-bottom: 26px;
	}

	.status-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 12px rgba(85, 214, 190, 0.7);
	}

	h1 {
		font-size: clamp(42px, 5vw, 70px);
		line-height: 1.05;
		letter-spacing: -0.045em;
		margin: 0;
		max-width: 760px;
	}

	h1 span {
		color: var(--text-muted);
	}

	.hero-description {
		color: var(--text-muted);
		font-size: 18px;
		line-height: 1.8;
		max-width: 650px;
		margin: 30px 0 0;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-top: 38px;
	}

	.primary-button,
	.secondary-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 16px;

		padding: 13px 18px;
		border-radius: 7px;
		text-decoration: none;
		font-size: 14px;
		font-weight: 600;
		transition: 150ms ease;
	}

	.primary-button {
		background: var(--accent);
		color: var(--background);
		border: 1px solid var(--accent);
	}

	.primary-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 30px rgba(85, 214, 190, 0.15);
	}

	.secondary-button {
		border: 1px solid var(--border);
		color: var(--text-muted);
		background: var(--surface);
	}

	.secondary-button:hover {
		color: var(--text);
		border-color: var(--accent);
	}

	.terminal {
		background: var(--code-background);
		border: 1px solid var(--border);
		border-radius: 10px;
		overflow: hidden;
		box-shadow:
			0 30px 80px rgba(0, 0, 0, 0.35),
			0 0 0 1px rgba(255, 255, 255, 0.015);
	}

	.terminal-header {
		height: 43px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 15px;
		border-bottom: 1px solid var(--border);
		background: var(--surface);
		color: var(--text-muted);

		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 11px;
	}

	.terminal-dots {
		display: flex;
		gap: 7px;
	}

	.terminal-dots span {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--border);
	}

	.terminal-body {
		padding: 24px;
		min-height: 315px;

		font-family:
			"SFMono-Regular",
			Consolas,
			"Liberation Mono",
			monospace;

		font-size: 13px;
		line-height: 1.7;
		color: var(--text);
	}

	.terminal-body p {
		margin: 0 0 10px;
	}

	.terminal-green {
		color: var(--accent);
	}

	.terminal-blue {
		color: #70a5eb;
	}

	.terminal-output {
		color: var(--text-muted);
		padding-left: 4px;
		margin-bottom: 18px !important;
	}

	.terminal-list {
		display: flex;
		flex-direction: column;
		margin-bottom: 20px;
	}

	.cursor {
		display: inline-block;
		width: 7px;
		height: 15px;
		background: var(--accent);
		vertical-align: middle;
		margin-left: 4px;
		animation: blink 1.1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.section {
		padding: 90px 0;
		border-top: 1px solid var(--border);
	}

	.section-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 40px;
		margin-bottom: 42px;
	}

	.section-heading > p {
		max-width: 430px;
		color: var(--text-muted);
		font-size: 14px;
		line-height: 1.7;
		margin: 0;
	}

	.eyebrow {
		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 11px;
		letter-spacing: 0.14em;
		color: var(--accent);
	}

	h2 {
		font-size: 34px;
		letter-spacing: -0.03em;
		margin: 8px 0 0;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
	}

	.card {
		display: block;
		padding: 28px;
		min-height: 260px;

		border: 1px solid var(--border);
		border-radius: 9px;

		background:
			linear-gradient(
				145deg,
				rgba(255, 255, 255, 0.018),
				transparent
			),
			var(--surface);

		text-decoration: none;

		transition:
			transform 160ms ease,
			border-color 160ms ease,
			background 160ms ease;
	}

	.card:hover {
		transform: translateY(-3px);
		border-color: rgba(85, 214, 190, 0.35);
		background: var(--surface-light);
	}

	.card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 42px;
	}

	.card-number {
		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 12px;
		color: var(--accent);
	}

	.card-arrow {
		color: var(--text-muted);
		font-size: 20px;
		transition: 160ms ease;
	}

	.card:hover .card-arrow {
		color: var(--accent);
		transform: translate(2px, -2px);
	}

	.card h3 {
		font-size: 21px;
		margin: 0 0 12px;
	}

	.card p {
		color: var(--text-muted);
		font-size: 14px;
		line-height: 1.7;
		margin: 0;
		max-width: 480px;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
		margin-top: 24px;
	}

	.tags span {
		padding: 5px 8px;
		border: 1px solid var(--border);
		border-radius: 4px;

		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 10px;
		color: var(--text-muted);
		background: var(--tag-background);
	}

	.latest-section {
		padding-bottom: 100px;
	}

	.view-all {
		color: var(--accent);
		font-size: 13px;
		text-decoration: none;
	}

	.view-all:hover {
		text-decoration: underline;
	}

	.research-placeholder {
		border: 1px dashed var(--border);
		border-radius: 9px;
		padding: 32px;

		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 30px;

		background: var(--surface);
	}

	.placeholder-type {
		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 10px;
		color: var(--accent);
		letter-spacing: 0.12em;
	}

	.research-placeholder h3 {
		margin: 10px 0;
		font-size: 20px;
	}

	.research-placeholder p {
		color: var(--text-muted);
		font-size: 14px;
		line-height: 1.6;
		margin: 0;
	}

	.placeholder-status {
		flex-shrink: 0;

		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 10px;
		letter-spacing: 0.1em;
		color: var(--text-muted);

		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 7px 9px;
	}

	.principles {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.principle {
		display: flex;
		gap: 20px;
		padding: 35px 30px;
	}

	.principle + .principle {
		border-left: 1px solid var(--border);
	}

	.principle-value {
		color: var(--accent);

		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 11px;
	}

	.principle h3 {
		margin: 0 0 8px;
		font-size: 16px;
	}

	.principle p {
		margin: 0;
		color: var(--text-muted);
		font-size: 13px;
		line-height: 1.6;
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 40px;
			padding: 70px 0;
		}

		.terminal {
			max-width: 650px;
		}

		.cards {
			grid-template-columns: 1fr;
		}

		.principles {
			grid-template-columns: 1fr;
		}

		.principle + .principle {
			border-left: 0;
			border-top: 1px solid var(--border);
		}
	}

	@media (max-width: 650px) {
		main {
			padding: 0 18px;
		}

		.hero {
			min-height: auto;
			padding: 60px 0 75px;
		}

		h1 {
			font-size: 40px;
		}

		.hero-description {
			font-size: 16px;
		}

		.hero-actions {
			align-items: stretch;
			flex-direction: column;
		}

		.section {
			padding: 65px 0;
		}

		.section-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 18px;
		}

		.research-placeholder {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>