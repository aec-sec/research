---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const labs = (await getCollection('labs'))
	.filter((entry) => !entry.data.draft)
	.sort(
		(a, b) =>
			b.data.published.valueOf() - a.data.published.valueOf()
	);

const featuredLab = labs.find(
	(lab) => lab.data.featured
);

const archiveLabs = labs.filter(
	(lab) => lab.id !== featuredLab?.id
);
---

<Layout
	title="Labs | AEC Security"
	description="Hands-on offensive security labs, vulnerable machines, Active Directory environments and exploitation walkthroughs."
>
	<main>
		<section class="labs-hero">
			<div class="breadcrumb">
				<span>~/</span>labs
			</div>

			<h1>Labs & Machines</h1>

			<p>
				Practical offensive security write-ups covering vulnerable machines,
				Active Directory environments, web applications, exploitation and
				privilege escalation.
			</p>
		</section>

		<section class="labs-content">
			<div class="labs-header">
				<div>
					<span class="eyebrow">LAB ARCHIVE</span>
					<h2>Published Labs</h2>
				</div>

				<div class="filters">
					<button class="active">All</button>
					<button>Web</button>
					<button>Active Directory</button>
					<button>Linux</button>
					<button>Windows</button>
					<button>Network</button>
				</div>
			</div>

			{featuredLab && (
				<a
					class="featured"
					href={`/labs/${featuredLab.id}`}
				>
					<div class="featured-label">
						FEATURED LAB
					</div>

					<div class="featured-content">
						<div>
							<div class="meta">
								<span>{featuredLab.data.platform.toUpperCase()}</span>
								<span>•</span>
								<span>{featuredLab.data.category.toUpperCase()}</span>
								<span>•</span>
								<span>{featuredLab.data.difficulty.toUpperCase()}</span>
								<span>•</span>
								<span>
									{featuredLab.data.published.toLocaleDateString('en-GB')}
								</span>
							</div>

							<h3>{featuredLab.data.title}</h3>

							<p>{featuredLab.data.description}</p>

							<div class="tags">
								{featuredLab.data.tags.map((tag) => (
									<span>{tag}</span>
								))}
							</div>
						</div>

						<div class="featured-icon">
							<span>LAB</span>
						</div>
					</div>
				</a>
			)}

			{archiveLabs.length > 0 ? (
				<div class="lab-list">
					{archiveLabs.map((lab) => (
						<a
							class="lab-item"
							href={`/labs/${lab.id}`}
						>
							<div class="lab-meta">
								<span>{lab.data.platform}</span>
								<span>{lab.data.category}</span>
								<span>{lab.data.difficulty}</span>
								<span>{lab.data.os}</span>
								<span>
									{lab.data.published.toLocaleDateString('en-GB')}
								</span>
							</div>

							<h3>{lab.data.title}</h3>

							<p>{lab.data.description}</p>

							<div class="tags">
								{lab.data.tags.map((tag) => (
									<span>{tag}</span>
								))}
							</div>

							<div class="read-more">
								Read write-up <span>→</span>
							</div>
						</a>
					))}
				</div>
			) : (
				<div class="empty-state">
					<div class="empty-code">[ ]</div>

					<div>
						<h3>No additional labs published yet.</h3>
						<p>
							New lab write-ups and offensive security walkthroughs
							will appear here.
						</p>
					</div>
				</div>
			)}
		</section>

		<section class="methodology">
			<div class="methodology-heading">
				<span class="eyebrow">APPROACH</span>
				<h2>Lab methodology</h2>
			</div>

			<div class="methodology-grid">
				<div class="method">
					<span>01</span>
					<h3>Enumerate</h3>
					<p>
						Map the exposed attack surface, services, technologies
						and potential entry points.
					</p>
				</div>

				<div class="method">
					<span>02</span>
					<h3>Exploit</h3>
					<p>
						Identify weaknesses and develop a reliable path to
						initial access.
					</p>
				</div>

				<div class="method">
					<span>03</span>
					<h3>Escalate</h3>
					<p>
						Analyse the compromised environment and identify
						privilege escalation opportunities.
					</p>
				</div>

				<div class="method">
					<span>04</span>
					<h3>Document</h3>
					<p>
						Record the attack path, technical reasoning and
						key lessons from the exercise.
					</p>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	main {
		max-width: 1320px;
		margin: 0 auto;
		padding: 0 32px;
	}
	.labs-hero {
		padding: 100px 0 85px;
		max-width: 800px;
	}

	.breadcrumb {
		font-family: "SFMono-Regular", Consolas, monospace;
		color: var(--text-muted);
		font-size: 12px;
		margin-bottom: 25px;
	}

	.breadcrumb span {
		color: var(--accent);
	}

	h1 {
		font-size: clamp(48px, 6vw, 72px);
		letter-spacing: -0.05em;
		line-height: 1;
		margin: 0;
	}

	.labs-hero > p {
		max-width: 680px;
		color: var(--text-muted);
		font-size: 17px;
		line-height: 1.8;
		margin: 28px 0 0;
	}

	.labs-content {
		border-top: 1px solid var(--border);
		padding: 70px 0 100px;
	}

	.labs-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 30px;
		margin-bottom: 38px;
	}

	.eyebrow {
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 11px;
		letter-spacing: 0.14em;
		color: var(--accent);
	}

	h2 {
		font-size: 30px;
		letter-spacing: -0.03em;
		margin: 8px 0 0;
	}

	.filters {
		display: flex;
		gap: 7px;
		flex-wrap: wrap;
	}

	.filters button {
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text-muted);
		border-radius: 5px;
		padding: 7px 11px;
		font-size: 11px;
		cursor: pointer;
	}

	.filters button:hover,
	.filters button.active {
		color: var(--accent);
		border-color: rgba(85, 214, 190, 0.35);
	}

	.featured {
		border: 1px solid var(--border);
		border-radius: 9px;
		background:
			linear-gradient(
				120deg,
				rgba(85, 214, 190, 0.04),
				transparent 45%
			),
			var(--surface);
		overflow: hidden;
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.featured:hover {
		border-color: rgba(85, 214, 190, 0.4);
	}

	.featured-label {
		padding: 11px 20px;
		border-bottom: 1px solid var(--border);
		color: var(--accent);
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 10px;
		letter-spacing: 0.12em;
	}

	.featured-content {
		min-height: 270px;
		padding: 35px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 50px;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		color: var(--text-muted);
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 10px;
		letter-spacing: 0.08em;
	}

	.featured h3 {
		font-size: 28px;
		letter-spacing: -0.025em;
		margin: 16px 0 13px;
	}

	.featured p {
		color: var(--text-muted);
		line-height: 1.7;
		font-size: 14px;
		max-width: 650px;
		margin: 0;
	}

	.featured-icon {
		width: 130px;
		height: 130px;
		flex-shrink: 0;
		display: grid;
		place-items: center;
		border: 1px solid var(--border);
		border-radius: 50%;
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 20px;
		color: var(--accent);
		background:
			radial-gradient(
				circle,
				rgba(85, 214, 190, 0.09),
				transparent 65%
			);
	}

	.tags {
		display: flex;
		gap: 7px;
		flex-wrap: wrap;
		margin-top: 25px;
	}

	.tags span {
		padding: 5px 8px;
		border: 1px solid var(--border);
		border-radius: 4px;
		background: var(--tag-background);
		color: var(--text-muted);
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 10px;
	}

	.lab-list {
		display: grid;
		gap: 12px;
		margin-top: 16px;
	}

	.lab-item {
		display: block;
		padding: 26px 28px;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--surface);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease,
			background 0.2s ease;
	}

	.lab-item:hover {
		border-color: rgba(85, 214, 190, 0.4);
		background: var(--surface-light);
		transform: translateY(-2px);
	}

	.lab-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-bottom: 12px;
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 10px;
		letter-spacing: 0.08em;
		color: var(--accent);
	}

	.lab-item h3 {
		margin: 0 0 9px;
		font-size: 18px;
	}

	.lab-item p {
		margin: 0;
		max-width: 750px;
		color: var(--text-muted);
		font-size: 13px;
		line-height: 1.7;
	}

	.read-more {
		margin-top: 22px;
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 11px;
		color: var(--accent);
	}

	.read-more span {
		display: inline-block;
		margin-left: 5px;
		transition: transform 0.2s ease;
	}

	.lab-item:hover .read-more span {
		transform: translateX(4px);
	}

	.empty-state {
		display: flex;
		align-items: center;
		gap: 20px;
		margin-top: 16px;
		padding: 25px 28px;
		border: 1px dashed var(--border);
		border-radius: 8px;
	}

	.empty-code {
		color: var(--accent);
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 17px;
	}

	.empty-state h3 {
		margin: 0 0 6px;
		font-size: 15px;
	}

	.empty-state p {
		color: var(--text-muted);
		margin: 0;
		font-size: 13px;
		line-height: 1.6;
	}

	.methodology {
		border-top: 1px solid var(--border);
		padding: 80px 0 30px;
	}

	.methodology-heading {
		margin-bottom: 35px;
	}

	.methodology-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		border: 1px solid var(--border);
		border-radius: 9px;
		overflow: hidden;
	}

	.method {
		padding: 27px;
		background: var(--surface);
	}

	.method + .method {
		border-left: 1px solid var(--border);
	}

	.method > span {
		font-family: "SFMono-Regular", Consolas, monospace;
		font-size: 10px;
		color: var(--accent);
	}

	.method h3 {
		margin: 28px 0 9px;
		font-size: 16px;
	}

	.method p {
		color: var(--text-muted);
		font-size: 12px;
		line-height: 1.7;
		margin: 0;
	}

	@media (max-width: 850px) {
		.labs-header {
			align-items: flex-start;
			flex-direction: column;
		}

		.methodology-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.method:nth-child(3) {
			border-left: 0;
			border-top: 1px solid var(--border);
		}

		.method:nth-child(4) {
			border-top: 1px solid var(--border);
		}
	}

	@media (max-width: 600px) {
		main {
			padding: 0 18px;
		}

		.labs-hero {
			padding: 65px 0;
		}

		.featured-content {
			padding: 26px;
		}

		.featured-icon {
			display: none;
		}

		.methodology-grid {
			grid-template-columns: 1fr;
		}

		.method + .method {
			border-left: 0;
			border-top: 1px solid var(--border);
		}
	}
</style>