---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const labs = await getCollection('labs');

	return labs
		.filter((lab) => !lab.data.draft)
		.map((lab) => ({
			params: {
				id: lab.id,
			},
			props: {
				lab,
			},
		}));
}

const { lab } = Astro.props;

const { Content, headings } = await render(lab);

const tocHeadings = headings.filter(
	(heading) => heading.depth === 2 || heading.depth === 3
);

const words = lab.body.trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(words / 200));

const formattedDate = lab.data.published.toLocaleDateString('en-GB', {
	day: '2-digit',
	month: 'short',
	year: 'numeric',
});

const formattedUpdated = lab.data.updated
	? lab.data.updated.toLocaleDateString('en-GB', {
			day: '2-digit',
			month: 'short',
			year: 'numeric',
		})
	: null;
---

<Layout
	title={`${lab.data.title} | Labs | AEC Security`}
	description={lab.data.description}
>
	<main>

		<header class="lab-header">

			<div class="breadcrumb">
				<a href="/">AECSEC</a>
				<span>/</span>
				<a href="/labs">LABS</a>
				<span>/</span>
				<span>{lab.data.title.toUpperCase()}</span>
			</div>

			<div class="lab-header-content">

				<div class="lab-header-info">

					<div class="lab-meta">
						<span class="platform">{lab.data.platform}</span>
						<span>{lab.data.category}</span>
						<span>{formattedDate}</span>
						<span>{readingTime} MIN READ</span>
					</div>

					<h1>{lab.data.title}</h1>

					<p class="description">
						{lab.data.description}
					</p>

					<div class="lab-information">

						<div class="info-item">
							<span class="info-label">PLATFORM</span>
							<span class="info-value">{lab.data.platform}</span>
						</div>

						<div class="info-item">
							<span class="info-label">DIFFICULTY</span>
							<span class="info-value">{lab.data.difficulty}</span>
						</div>

						<div class="info-item">
							<span class="info-label">OPERATING SYSTEM</span>
							<span class="info-value">{lab.data.os}</span>
						</div>

						<div class="info-item">
							<span class="info-label">CATEGORY</span>
							<span class="info-value">{lab.data.category}</span>
						</div>

					</div>

					{formattedUpdated && (
						<div class="updated">
							Last updated {formattedUpdated}
						</div>
					)}

					{lab.data.tags.length > 0 && (
						<div class="tags">
							{lab.data.tags.map((tag) => (
								<span>{tag}</span>
							))}
						</div>
					)}

				</div>

				<div class="lab-logo">
					<img
						src="/images/labs/htb-academy.png"
						alt={`${lab.data.title} Hack The Box machine`}
					/>
				</div>

			</div>

		</header>


		<div class="article-layout">

			<article class="article-content">
				<Content />
			</article>

			<aside>
				<TableOfContents headings={tocHeadings} />
			</aside>

		</div>

	</main>
</Layout>


<style>

	/* =========================================================
	   PAGE
	   ========================================================= */

	main {
		max-width: var(--article-page-width);
		margin: 0 auto;
		padding: 0 var(--article-side-padding);
	}


	/* =========================================================
	   HEADER
	   ========================================================= */

	.lab-header-content {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 220px;
		gap: 55px;
		align-items: start;
	}

	.lab-header-info {
		min-width: 0;
	}

	.lab-logo {
		display: flex;
		align-items: flex-start;
		justify-content: center;

		padding-top: 5px;
	}

	.lab-logo img {
		display: block;

		width: 100%;
		max-width: 200px;
		height: auto;

		border-radius: 8px;
	}


	/* =========================================================
	   BREADCRUMB
	   ========================================================= */

	.breadcrumb {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px;

		margin-top: 20px;
		margin-bottom: 42px;

		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 10px;
		letter-spacing: 0.08em;

		color: var(--text-muted);
	}

	.breadcrumb a {
		color: var(--accent);
		text-decoration: none;
	}

	.breadcrumb a:hover {
		text-decoration: underline;
	}


	/* =========================================================
	   LAB META
	   ========================================================= */

	.lab-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;

		margin-bottom: 18px;

		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 10px;
		letter-spacing: 0.06em;

		color: var(--text-muted);
	}

	.lab-meta span:not(:last-child)::after {
		content: "·";
		margin-left: 12px;
		color: var(--border);
	}

	.lab-meta .platform {
		color: var(--accent);
	}


	/* =========================================================
	   TITLE / DESCRIPTION
	   ========================================================= */

	h1 {
		max-width: 900px;
		margin: 0;

		font-size: clamp(42px, 6vw, 68px);
		line-height: 1.04;
		letter-spacing: -0.045em;
	}

	.description {
		max-width: 780px;

		margin: 24px 0 0;

		font-size: 16px;
		line-height: 1.75;

		color: var(--text-muted);
	}


	/* =========================================================
	   LAB INFORMATION
	   ========================================================= */

	.lab-information {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));

		max-width: 850px;

		margin-top: 38px;

		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.info-item {
		display: flex;
		flex-direction: column;
		gap: 7px;

		padding: 18px 20px 18px 0;
	}

	.info-item:not(:last-child) {
		border-right: 1px solid var(--border);
		margin-right: 20px;
	}

	.info-label {
		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 8px;
		letter-spacing: 0.13em;

		color: var(--text-muted);
	}

	.info-value {
		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 11px;

		color: var(--text);
	}

	.updated {
		margin-top: 18px;

		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 9px;

		color: var(--text-muted);
	}


	/* =========================================================
	   TAGS
	   ========================================================= */

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;

		margin-top: 24px;
	}

	.tags span {
		padding: 5px 8px;

		border: 1px solid var(--border);
		border-radius: 4px;

		background: var(--tag-background);

		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 9px;

		color: var(--text-muted);
	}


	/* =========================================================
	   ARTICLE LAYOUT
	   ========================================================= */

	.article-layout {
		display: grid;

		grid-template-columns:
			minmax(0, var(--article-content-width))
			var(--article-nav-width);

		gap: var(--article-gap);

		max-width: calc(
			var(--article-content-width) +
			var(--article-nav-width) +
			var(--article-gap)
		);

		padding: 65px 0 110px;
	}

	.article-content {
		min-width: 0;
		width: 100%;
		max-width: var(--article-content-width);
	}


	/* =========================================================
	   MARKDOWN HEADINGS
	   ========================================================= */

	.article-content :global(h2) {
		margin: 65px 0 20px;

		font-size: 30px;
		line-height: 1.25;
		letter-spacing: -0.035em;

		scroll-margin-top: 100px;
	}

	.article-content :global(h2:first-child) {
		margin-top: 0;
	}

	.article-content :global(h3) {
		margin: 42px 0 16px;

		font-size: 21px;
		line-height: 1.35;
		letter-spacing: -0.02em;

		scroll-margin-top: 100px;
	}

	.article-content :global(h4) {
		margin: 32px 0 12px;

		font-size: 17px;
	}


	/* =========================================================
	   TEXT
	   ========================================================= */

	.article-content :global(p) {
		margin: 0 0 20px;

		color: var(--text-muted);

		font-size: 14px;
		line-height: 1.85;
	}

	.article-content :global(strong) {
		color: var(--text);
	}

	.article-content :global(a) {
		color: var(--accent);

		text-decoration: underline;
		text-underline-offset: 3px;
	}


	/* =========================================================
	   LISTS
	   ========================================================= */

	.article-content :global(ul),
	.article-content :global(ol) {
		margin: 0 0 24px;
		padding-left: 24px;

		color: var(--text-muted);

		font-size: 14px;
		line-height: 1.8;
	}

	.article-content :global(li) {
		margin-bottom: 6px;
	}


	/* =========================================================
	   BLOCKQUOTES
	   ========================================================= */

	.article-content :global(blockquote) {
		margin: 28px 0;
		padding: 3px 0 3px 20px;

		border-left: 2px solid var(--accent);

		color: var(--text-muted);
	}

	.article-content :global(blockquote p) {
		margin: 0;
	}


	/* =========================================================
	   INLINE CODE
	   ========================================================= */

	.article-content :global(code) {
		padding: 2px 5px;

		border: 1px solid var(--border);
		border-radius: 4px;

		background: var(--code-background);

		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 0.88em;

		color: var(--text);
	}


	/* =========================================================
	   CODE BLOCKS
	   ========================================================= */

	.article-content :global(pre) {
		overflow-x: auto;

		margin: 26px 0;
		padding: 20px 22px;

		border: 1px solid var(--border);
		border-radius: 6px;

		background: var(--code-background);
	}

	.article-content :global(pre code) {
		padding: 0;

		border: 0;

		background: transparent;

		font-size: 12px;
		line-height: 1.7;
	}


	/* =========================================================
	   TABLES
	   ========================================================= */

	.article-content :global(table) {
		width: 100%;

		margin: 28px 0;

		border-collapse: collapse;

		font-size: 13px;
	}

	.article-content :global(th),
	.article-content :global(td) {
		padding: 12px 14px;

		border: 1px solid var(--border);

		text-align: left;
		vertical-align: top;
	}

	.article-content :global(th) {
		background: var(--surface);

		color: var(--text);

		font-family:
			"SFMono-Regular",
			Consolas,
			monospace;

		font-size: 10px;
		letter-spacing: 0.05em;
	}

	.article-content :global(td) {
		color: var(--text-muted);
	}


	/* =========================================================
	   HORIZONTAL RULE
	   ========================================================= */

	.article-content :global(hr) {
		margin: 50px 0;

		border: 0;
		border-top: 1px solid var(--border);
	}


	/* =========================================================
	   IMAGES
	   ========================================================= */

	.article-content :global(img) {
		display: block;

		max-width: 100%;
		height: auto;

		margin: 30px 0;

		border: 1px solid var(--border);
		border-radius: 6px;
	}


	/* =========================================================
	   RESPONSIVE — TABLET
	   ========================================================= */

	@media (max-width: 950px) {

		.article-layout {
			grid-template-columns: 1fr;
			gap: 0;
		}

		aside {
			display: none;
		}

		.article-content {
			max-width: 850px;
		}
	}


	/* =========================================================
	   RESPONSIVE — MOBILE
	   ========================================================= */

	@media (max-width: 750px) {

		main {
			padding: 0 18px;
		}

		.lab-header {
			padding: 65px 0 40px;
		}

		.breadcrumb {
			margin-bottom: 32px;
		}

		h1 {
			font-size: 42px;
		}

		.description {
			font-size: 14px;
		}

		.lab-information {
			grid-template-columns: repeat(2, 1fr);
		}

		.info-item {
			padding: 15px 10px 15px 0;
		}

		.info-item:not(:last-child) {
			margin-right: 10px;
		}

		.info-item:nth-child(2) {
			border-right: 0;
		}

		.article-layout {
			padding: 45px 0 80px;
		}

		.article-content :global(h2) {
			margin-top: 50px;

			font-size: 26px;
		}

		.lab-header-content {
			grid-template-columns: 1fr;
			gap: 30px;
		}

		.lab-logo {
			justify-content: flex-start;
		}

		.lab-logo img {
			max-width: 150px;
		}
	}


	/* =========================================================
	   RESPONSIVE — SMALL MOBILE
	   ========================================================= */

	@media (max-width: 480px) {

		.lab-information {
			grid-template-columns: 1fr;
		}

		.info-item:not(:last-child) {
			margin-right: 0;

			border-right: 0;
			border-bottom: 1px solid var(--border);
		}
	}

</style>